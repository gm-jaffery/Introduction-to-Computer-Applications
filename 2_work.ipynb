import pandas as pd
import numpy as np
import hashlib

ORIG = "teaching_prices_messy.csv"
COPY = "teaching_prices_copy.csv"

# Verify original hash
with open(ORIG,"rb") as f:
    print("Original SHA-256:", hashlib.sha256(f.read()).hexdigest())

# Load the copy
df = pd.read_csv(COPY, dtype=str, keep_default_na=False)
print(f"BEFORE shape: {df.shape}")
print("Missing prices:", (df['price'] == '').sum())
print("Exact dupes:", df.duplicated().sum())
print("Unique items:", df['item'].unique())
